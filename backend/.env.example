# Server
PORT=5000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=smart_district
PGUSER=postgres
PGPASSWORD=replace_with_your_password

# Set to true only when your hosted PostgreSQL provider requires TLS.
PGSSLMODE=false

# AI integration. Without credentials, the application uses clearly labelled demo AI.
AI_PROVIDER=demo
AI_API_KEY=
